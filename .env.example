# ---------------------------------------------------------------- server
PORT=5001
NODE_ENV=development

# ---------------------------------------------------------------- database
# Local MongoDB (a portable mongod running on this machine):
MONGODB_URI=mongodb://127.0.0.1:27017/job-portal

# MongoDB Atlas (free tier) - create a cluster, add a database user, allow your
# IP in Network Access, then copy the SRV string from "Connect > Drivers":
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/job-portal?retryWrites=true&w=majority
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/job-portal?retryWrites=true&w=majority

# ---------------------------------------------------------------- auth
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string-of-at-least-32-characters
JWT_EXPIRES_IN=7d

# ---------------------------------------------------------------- cors
# Comma separated list of browser origins allowed to call the API.
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175

# ---------------------------------------------------------------- uploads
# Folder where uploaded CV files are stored. Created automatically at startup.
UPLOAD_DIR=uploads

# Maximum CV upload size in megabytes (5 MB by default).
MAX_CV_SIZE_MB=5
